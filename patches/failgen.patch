+                    details = self._apply_object_collision(point)
+                else:
+                    self._state = CollisionState.APPLIED
+                    details = self._apply_down_collision(point)
+                print(
+                    f"[COLLISION DEBUG] >>> COLLISION INDUCED at {point._waypoint.get_name()}! "
+                    f"{details}"
+                )
