+def _wrist_image_size(default):
+    """Wrist resolution, overridable with AHA_WRIST_IMAGE_SIZE.
+
+    The VLM reads gripper finger state almost entirely from wrist_rgb, but at
+    the configs' default 256x256 a fingertip pad is only ~15px wide and the gap
+    that separates a clamped grip from an open one spans a handful of pixels.
+    Rendering just this one camera larger sharpens that judgement without paying
+    the render/token cost on the other four. Accepts "768" or "768,768"/"768x768".
+    """
+    raw = os.getenv("AHA_WRIST_IMAGE_SIZE", "").strip().lower()
+    if not raw:
+        return default
+
+    parts = [part for part in raw.replace("x", ",").split(",") if part.strip()]
+    try:
+        values = [int(part) for part in parts]
+    except ValueError:
+        values = []
+
+    if len(values) == 1:
+        values = values * 2
+    if len(values) != 2 or any(value <= 0 for value in values):
+        warnings.warn(
+            f"AHA_WRIST_IMAGE_SIZE={raw!r} is not a size like '768' or "
+            f"'768,768'; keeping {tuple(default)}."
+        )
+        return default
+
+    return tuple(values)
+
