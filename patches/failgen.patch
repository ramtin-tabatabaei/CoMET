index 0000000000000000000000000000000000000000..d4dd31944937ee081d98cfc295360c8cd564fb81
--- /dev/null
+++ b/failgen/fail_collision.py
@@ -0,0 +1,514 @@
+# Copyright (c) 2025 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+#
+# Licensed under the NVIDIA Source Code License [see LICENSE for details].
+import os
+from enum import Enum
+from typing import List, Optional, Tuple
+
+import numpy as np
+from pyrep.objects.object import Object
+from rlbench.backend.robot import Robot
+from rlbench.backend.task import Task
+from rlbench.backend.waypoints import Waypoint
+
+from failgen.fail_instance import IFailure
+
+
+class CollisionState(Enum):
+    IDLE = 0
+    ARMED = 1
+    APPLYING = 2
+    APPLIED = 3
+
+
+class CollisionFailure(IFailure):
+    FAILURE_TYPE = "collision"
+
+    def __init__(
+        self,
+        robot: Robot,
+        name: str,
+        waypoints_indices: List[int],
+        mode: str = "down",
+        push_down_range: Tuple[float, float] = (0.15, 0.30),
+        lateral_range: Tuple[float, float] = (-0.10, 0.10),
+        approach_distance_range: Tuple[float, float] = (0.10, 0.20),
+        approach_lateral_x_range: Tuple[float, float] = (0.0, 0.0),
+        approach_lateral_y_range: Tuple[float, float] = (0.0, 0.0),
+        approach_axis: str = "z",
+        max_planar_distance: float = 0.0,
+        runtime_step_delay: int = 2,
+        runtime_duration_steps: int = 60,
+        target_objects: Optional[List[str]] = None,
+        object_overshoot_range: Tuple[float, float] = (0.03, 0.08),
+    ):
+        super().__init__(
+            robot=robot, name=name, waypoints_indices=waypoints_indices
+        )
+        self._failure_type = CollisionFailure.FAILURE_TYPE
+        self._state = CollisionState.IDLE
+        self._mode = str(mode).strip().lower()
+        self._push_down_range = push_down_range
+        self._lateral_range = lateral_range
+        self._approach_distance_range = approach_distance_range
+        self._approach_lateral_x_range = approach_lateral_x_range
+        self._approach_lateral_y_range = approach_lateral_y_range
+        self._approach_axis = approach_axis
+        self._max_planar_distance = max(0.0, float(max_planar_distance))
+        self._runtime_step_delay = max(0, int(runtime_step_delay))
+        self._runtime_duration_steps = max(1, int(runtime_duration_steps))
+        if os.getenv("AHA_FAIL_EXTREME", "").strip().lower() in (
+            "1", "true", "yes", "on"
+        ):
+            self._runtime_duration_steps = max(self._runtime_duration_steps, 36)
+        self._target_objects = (
+            list(target_objects) if target_objects is not None else []
+        )
+        self._object_overshoot_range = object_overshoot_range
+        self._armed_steps = 0
+        self._runtime_steps = 0
+        self._runtime_direction = None
+        self._runtime_lateral_x_direction = None
+        self._runtime_lateral_y_direction = None
+        self._runtime_target_obj = None
+        self._runtime_start_joints = None
+        self._runtime_goal_joints = None
+
+    def on_start(self, task: Task) -> None:
+        ...
+
+    def on_reset(self) -> None:
+        self._state = CollisionState.IDLE
+        self._armed_steps = 0
+        self._runtime_steps = 0
+        self._runtime_direction = None
+        self._runtime_lateral_x_direction = None
+        self._runtime_lateral_y_direction = None
+        self._runtime_target_obj = None
+        self._runtime_start_joints = None
+        self._runtime_goal_joints = None
+
+    def on_step(self) -> None:
+        ...
+
+    def _sample_range(self, value_range: Tuple[float, float]) -> float:
+        low, high = value_range
+        low = float(low)
+        high = max(low, float(high))
+        if os.getenv("AHA_FAIL_EXTREME", "").strip().lower() in (
+            "1", "true", "yes", "on"
+        ):
+            return high
+        return float(np.random.uniform(low, high))
+
+    def _axis_direction(
+        self, point: Waypoint, axis: Optional[str] = None
+    ) -> np.ndarray:
+        uses_config_axis = axis is None
+        axis = self._approach_axis if axis is None else axis
+        axis = str(axis).strip().lower()
+        sign = -1.0 if axis.startswith("-") else 1.0
+        axis_name = axis[1:] if axis.startswith("-") else axis
+        axis_name = axis_name.replace("local_", "")
+        axis_index = {"x": 0, "y": 1, "z": 2}.get(axis_name, 2)
+
+        matrix = np.array(point._waypoint.get_matrix())
+        if matrix.size == 16:
+            matrix = matrix.reshape(4, 4)[:3, :3]
+        else:
+            matrix = matrix.reshape(3, 4)[:, :3]
+        direction = matrix[:, axis_index] * sign
+        norm = np.linalg.norm(direction)
+        if norm < 1e-8:
+            if not uses_config_axis:
+                fallback = np.zeros(3)
+                fallback[axis_index] = sign
+                return fallback
+            return np.array([0.0, 0.0, -1.0])
+        return direction / norm
+
+    def _limit_approach_distance(self, direction: np.ndarray, distance: float) -> float:
+        limited_distance = distance
+
+        planar_magnitude = np.linalg.norm(direction[:2])
+        if self._max_planar_distance > 0.0 and planar_magnitude > 1e-8:
+            limited_distance = min(
+                limited_distance,
+                self._max_planar_distance / planar_magnitude,
+            )
+
+        return limited_distance
+
+    def _sample_approach_offset(
+        self,
+        direction: np.ndarray,
+        lateral_x_direction: np.ndarray,
+        lateral_y_direction: np.ndarray,
+    ) -> Tuple[np.ndarray, float, float, float, float]:
+        sampled_distance = self._sample_range(self._approach_distance_range)
+        distance = self._limit_approach_distance(direction, sampled_distance)
+        lateral_x = self._sample_range(self._approach_lateral_x_range)
+        lateral_y = self._sample_range(self._approach_lateral_y_range)
+        offset = (
+            direction * distance
+            + lateral_x_direction * lateral_x
+            + lateral_y_direction * lateral_y
+        )
+        return offset, distance, sampled_distance, lateral_x, lateral_y
+
+    def _apply_down_collision(self, point: Waypoint) -> str:
+        position = point._waypoint.get_position()
+        down_offset = self._sample_range(self._push_down_range)
+        dx = self._sample_range(self._lateral_range)
+        dy = self._sample_range(self._lateral_range)
+        position[0] += dx
+        position[1] += dy
+        position[2] -= down_offset
+        point._waypoint.set_position(position)
+        return f"mode=down, down={down_offset:.3f}m, lateral=({dx:.3f}, {dy:.3f})m"
+
+    def _apply_approach_collision(self, point: Waypoint) -> str:
+        position = np.array(point._waypoint.get_position())
+        direction = self._axis_direction(point)
+        lateral_x_direction = self._axis_direction(point, "x")
+        lateral_y_direction = self._axis_direction(point, "y")
+        offset, distance, sampled_distance, lateral_x, lateral_y = (
+            self._sample_approach_offset(
+                direction, lateral_x_direction, lateral_y_direction
+            )
+        )
+        new_position = position + offset
+        point._waypoint.set_position(new_position.tolist())
+        return (
+            f"mode=approach, axis={self._approach_axis}, "
+            f"distance={distance:.3f}m, sampled={sampled_distance:.3f}m, "
+            f"local_lateral=({lateral_x:.3f}, {lateral_y:.3f})m, "
+            f"direction={direction.round(3).tolist()}"
+        )
+
+    def _named_target_objects(self) -> List[Object]:
+        targets = []
+        for name in self._target_objects:
+            try:
+                targets.append(Object.get_object(name))
+            except Exception:
+                print(f"[COLLISION DEBUG] Could not find target object '{name}'")
+        return targets
+
+    def _task_tree_target_objects(self, waypoint_name: str) -> List[Object]:
+        if self._obj_base is None:
+            return []
+
+        try:
+            candidates = self._obj_base.get_objects_in_tree(exclude_base=True)
+        except TypeError:
+            candidates = self._obj_base.get_objects_in_tree()
+        except Exception:
+            return []
+
+        targets = []
+        robot_handles = set()
+        for robot_obj in self._robot.arm.get_objects_in_tree():
+            try:
+                robot_handles.add(robot_obj.get_handle())
+            except Exception:
+                continue
+        for obj in candidates:
+            try:
+                name = obj.get_name()
+                handle = obj.get_handle()
+            except Exception:
+                continue
+            if name == waypoint_name or name.startswith("waypoint"):
+                continue
+            if handle in robot_handles:
+                continue
+            is_collidable = getattr(obj, "is_collidable", None)
+            if not callable(is_collidable) or not is_collidable():
+                continue
+            targets.append(obj)
+        return targets
+
+    def _select_object_target(self, point: Waypoint) -> Optional[Object]:
+        waypoint_name = point._waypoint.get_name()
+        targets = self._named_target_objects()
+        if not targets:
+            targets = self._task_tree_target_objects(waypoint_name)
+        if not targets:
+            return None
+
+        waypoint_position = np.array(point._waypoint.get_position())
+        scored_targets = []
+        for target in targets:
+            try:
+                target_position = np.array(target.get_position())
+                distance = np.linalg.norm(target_position - waypoint_position)
+            except Exception:
+                continue
+            scored_targets.append((distance, target, target_position))
+
+        if not scored_targets:
+            return None
+        scored_targets.sort(key=lambda item: item[0])
+        return scored_targets[0][1]
+
+    def _apply_object_collision(self, point: Waypoint) -> str:
+        position = np.array(point._waypoint.get_position())
+        target = self._select_object_target(point)
+        if target is None:
+            return self._apply_approach_collision(point) + ", fallback=no_object_target"
+
+        target_position = np.array(target.get_position())
+        direction = target_position - position
+        norm = np.linalg.norm(direction)
+        if norm < 1e-8:
+            direction = self._axis_direction(point)
+        else:
+            direction = direction / norm
+
+        overshoot = self._sample_range(self._object_overshoot_range)
+        new_position = target_position + direction * overshoot
+        point._waypoint.set_position(new_position.tolist())
+        return (
+            f"mode=object, target={target.get_name()}, "
+            f"overshoot={overshoot:.3f}m"
+        )
+
+    def _select_runtime_target(self, point: Waypoint) -> Optional[Object]:
+        """Pick the best object to ram for a detectable collision. Prefer a
+        STATIC (immovable) collidable — pushing a fixture/support builds torque,
+        whereas a free/grasped object just moves and yields no torque. Skip the
+        currently-grasped object(s). Among the preference tier, take the nearest
+        to the tip. Returns None if nothing suitable -> caller does a table-ram."""
+        waypoint_name = point._waypoint.get_name()
+        targets = self._named_target_objects()
+        if not targets:
+            targets = self._task_tree_target_objects(waypoint_name)
+        if not targets:
+            return None
+        grasped = set()
+        try:
+            for o in self._robot.gripper.get_grasped_objects():
+                grasped.add(o.get_handle())
+        except Exception:
+            pass
+        try:
+            tip_pos = np.array(self._robot.arm.get_tip().get_position())
+        except Exception:
+            tip_pos = np.array(point._waypoint.get_position())
+        scored = []
+        for obj in targets:
+            try:
+                if obj.get_handle() in grasped:
+                    continue
+                dist = float(np.linalg.norm(np.array(obj.get_position()) - tip_pos))
+            except Exception:
+                continue
+            try:
+                dynamic = bool(obj.is_dynamic())
+            except Exception:
+                dynamic = True  # unknown / non-shape: treat as movable (deprioritise)
+            scored.append((0 if not dynamic else 1, dist, obj))
+        if not scored:
+            return None
+        scored.sort(key=lambda s: (s[0], s[1]))  # static first, then nearest
+        return scored[0][2]
+
+    def _arm_runtime_approach_collision(self, point: Waypoint) -> None:
+        self._state = CollisionState.ARMED
+        self._armed_steps = 0
+        self._runtime_steps = 0
+        self._runtime_direction = self._axis_direction(point)
+        self._runtime_lateral_x_direction = self._axis_direction(point, "x")
+        self._runtime_lateral_y_direction = self._axis_direction(point, "y")
+        self._runtime_start_joints = None
+        self._runtime_goal_joints = None
+        # Aim the runtime push at the nearest STATIC collidable object (a fixture
+        # or support that resists -> torque), skipping the grasped object. If no
+        # rigid target is in reach, _prepare_runtime_approach_target rams downward
+        # into the table. A free-space / soft-object push is not a real collision.
+        self._runtime_target_obj = self._select_runtime_target(point)
+        target_note = (
+            f", target={self._runtime_target_obj.get_name()}"
+            if self._runtime_target_obj is not None else ", target=none(axis-push)"
+        )
+        print(
+            f"[COLLISION DEBUG] >>> COLLISION ARMED at {point._waypoint.get_name()}! "
+            f"mode=approach_runtime, axis={self._approach_axis}, "
+            f"direction={self._runtime_direction.round(3).tolist()}{target_note}"
+        )
+
+    def _prepare_runtime_approach_target(self) -> None:
+        direction = self._runtime_direction
+        if direction is None:
+            direction = np.array([0.0, 0.0, -1.0])
+        lateral_x_direction = self._runtime_lateral_x_direction
+        if lateral_x_direction is None:
+            lateral_x_direction = np.array([1.0, 0.0, 0.0])
+        lateral_y_direction = self._runtime_lateral_y_direction
+        if lateral_y_direction is None:
+            lateral_y_direction = np.array([0.0, 1.0, 0.0])
+
+        tip = self._robot.arm.get_tip()
+        position = np.array(tip.get_position())
+        # If a rigid target object was found at arm time, push from the current
+        # tip toward it and overshoot into it so the gripper actually collides
+        # (guaranteed contact -> torque). Fall back to the configured axis push.
+        # Drive firmly into the contact (>= 12 cm past the surface) so torque
+        # builds before the recovery ramp; a 3-4 cm tap is too soft to register.
+        extreme = os.getenv("AHA_FAIL_EXTREME", "").strip().lower() in (
+            "1", "true", "yes", "on"
+        )
+        runtime_overshoot = max(
+            self._object_overshoot_range[1],
+            0.20 if extreme else 0.12,
+        )
+        down = np.array([0.0, 0.0, -1.0])
+        TABLE_RAM = 0.25 if extreme else 0.18
+        if self._runtime_target_obj is not None:
+            try:
+                target_pos = np.array(self._runtime_target_obj.get_position())
+                to_target = target_pos - position
+                reach = float(np.linalg.norm(to_target))
+                if reach > 1e-6:
+                    direction = to_target / reach
+                    distance = sampled_distance = reach + runtime_overshoot
+                else:
+                    direction, distance = down, TABLE_RAM
+                    sampled_distance = TABLE_RAM
+            except Exception:
+                direction, distance = down, TABLE_RAM
+                sampled_distance = TABLE_RAM
+        else:
+            # No rigid target in reach: ram straight down into the table/support,
+            # which is universally present and immovable -> reliable torque.
+            direction, distance = down, TABLE_RAM
+            sampled_distance = TABLE_RAM
+        lateral_x = lateral_y = 0.0
+        offset = direction * distance
+        target_position = position + offset
+
+        try:
+            target_joints = self._robot.arm.solve_ik_via_jacobian(
+                target_position.tolist(),
+                euler=tip.get_orientation(),
+            )
+        except Exception as exc:
+            # Object-aim target unreachable: fall back to the small configured
+            # axis push (reliably IK-solvable) so we still induce a collision
+            # rather than silently skipping it.
