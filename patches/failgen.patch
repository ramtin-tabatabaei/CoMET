+def _sample_norm_constrained(
+    axis_max: float, min_norm: float, max_tries: int = 1000
+) -> np.ndarray:
+    """Sample a 3-vector with each component in [-axis_max, axis_max] whose
+    Euclidean norm is at least ``min_norm``.
+
+    Each axis independently gets a signed magnitude in [0, axis_max]; the whole
+    vector is resampled until it clears ``min_norm``. If ``min_norm`` is not
+    reachable within ``axis_max`` (or the loop is exhausted), a fallback vector
+    that puts the required magnitude on a single random axis is returned.
+    """
+    min_norm = min(min_norm, axis_max)
+    for _ in range(max_tries):
+        v = np.random.uniform(-axis_max, axis_max, size=3)
+        if np.linalg.norm(v) >= min_norm:
+            return v
+    v = np.zeros(3)
+    axis = np.random.randint(3)
+    v[axis] = min_norm if np.random.rand() < 0.5 else -min_norm
+    return v
+
