@@ -0,0 +1,103 @@
+# Copyright (c) 2025 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+#
+# Licensed under the NVIDIA Source Code License [see LICENSE for details].
+
+from typing import List, Optional
+
+import numpy as np
+from rlbench.backend.robot import Robot
+from rlbench.backend.task import Task
+from rlbench.backend.waypoints import Waypoint
+
+from failgen.fail_instance import IFailure
+
+# Set by WrongSequenceV2Failure.on_start() before the shuffle. Maps each live
+# waypoints-list slot to the ORIGINAL index whose Waypoint now sits there, i.e.
+# task._waypoints[new_slot] holds the waypoint that was originally at
+# _shuffle_permutation[new_slot]. The BT runner can use this to reconstruct the
+# clean ordering. None for non-wrong_sequence_v2 runs. Mirrors fail_sequence._swap_indices.
+_shuffle_permutation = None
+
+
+class WrongSequenceV2Failure(IFailure):
+    """Reorders the ENTIRE set of configured waypoints into a random, non-identity
+    permutation (a full scramble), instead of swapping a single pair like
+    ``wrong_sequence``. The robot then visits every waypoint, but in a shuffled
+    order. Like ``wrong_sequence`` this only reorders ``task._waypoints`` in place;
+    it does not perturb any individual motion, and no motion detector need fire.
+    """
+
+    FAILURE_TYPE = "wrong_sequence_v2"
+
+    def __init__(
+        self,
+        robot: Robot,
+        name: str,
+        waypoints_indices: List[int],
+        seed: Optional[int] = 10,
+    ):
+        super().__init__(
+            robot=robot, name=name, waypoints_indices=waypoints_indices
+        )
+
+        self._failure_type = WrongSequenceV2Failure.FAILURE_TYPE
+        # Indices to shuffle among themselves. An empty list means "shuffle every
+        # waypoint the task has" (resolved lazily in on_start once waypoints load).
+        self._indices_to_shuffle = waypoints_indices.copy()
+        self._seed = seed
+
+    def _make_permutation(self, indices: List[int]) -> List[int]:
+        """Return a shuffled copy of ``indices`` that is guaranteed to differ from
+        the input order when possible (>= 2 elements)."""
+        n = len(indices)
+        if n < 2:
+            return list(indices)
+
+        rng = np.random.default_rng(self._seed)
+        shuffled = list(indices)
+        # Retry until the permutation is non-identity so the order genuinely changes.
+        for _ in range(100):
+            rng.shuffle(shuffled)
+            if shuffled != list(indices):
+                return shuffled
+        # Degenerate fallback (e.g. all-equal seeding): rotate by one.
+        return list(indices[1:]) + [indices[0]]
+
+    def on_start(self, task: Task) -> None:
+        if not self._enabled:
+            return
+
+        assert (
+            task._waypoints is not None
+        ), "WrongSequenceV2Failure::on_start >> Must have waypoints loaded"
+
+        # Resolve which slots to shuffle: the configured subset, or all waypoints
+        # when none were specified.
+        indices = self._indices_to_shuffle or list(range(len(task._waypoints)))
+        indices = [i for i in indices if 0 <= i < len(task._waypoints)]
+        if len(indices) < 2:
+            return
+
+        order = self._make_permutation(indices)
+
+        global _shuffle_permutation
+        # Record slot -> original-index mapping before mutating the live list.
+        _shuffle_permutation = {dst: src for dst, src in zip(indices, order)}
+
+        # Snapshot the original waypoint objects, then scatter them into the new
+        # slots. Snapshot first so a shuffled slot never overwrites a not-yet-read one.
+        originals = {i: task._waypoints[i] for i in indices}
+        for dst, src in zip(indices, order):
+            task._waypoints[dst] = originals[src]
+
+    def on_reset(self) -> None:
+        # Do nothing for now
+        ...
+
+    def on_step(self) -> None:
+        # Do nothing for now
+        ...
+
+    def on_waypoint(self, point: Waypoint) -> None:
+        # Do nothing for now
+        ...
