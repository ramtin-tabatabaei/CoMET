+                self._sample_approach_offset(
+                    self._runtime_direction
+                    if self._runtime_direction is not None else direction,
+                    lateral_x_direction, lateral_y_direction))
+            try:
+                target_position = position + fb_offset
+                target_joints = self._robot.arm.solve_ik_via_jacobian(
+                    target_position.tolist(),
+                    euler=tip.get_orientation(),
+                )
+                print(
+                    "[COLLISION DEBUG] object-aim IK failed; using axis-push "
+                    f"fallback (distance={distance:.3f}m). Reason: {exc}"
+                )
+            except Exception as exc2:
+                print(
+                    "[COLLISION DEBUG] Runtime approach IK failed; "
+                    f"letting path continue. Reason: {exc2}"
+                )
+                self._state = CollisionState.APPLIED
+                return
+
+        self._runtime_start_joints = list(self._robot.arm.get_joint_positions())
+        self._runtime_goal_joints = list(target_joints)
+        print(
+            "[COLLISION DEBUG] >>> SMOOTH RUNTIME COLLISION PUSH! "
+            f"distance={distance:.3f}m, sampled={sampled_distance:.3f}m, "
+            f"local_lateral=({lateral_x:.3f}, {lateral_y:.3f})m, "
+            f"duration={self._runtime_duration_steps} steps"
+        )
+
+    def _smoothstep(self, value: float) -> float:
+        value = max(0.0, min(1.0, value))
+        return value * value * (3.0 - 2.0 * value)
+
+    def _runtime_alpha(self) -> float:
+        total = max(1, self._runtime_duration_steps)
+        if total <= 2:
+            return 1.0
+
+        ramp_steps = max(1, total // 3)
+        recover_steps = ramp_steps
+        step = min(self._runtime_steps, total - 1)
+        recover_start = total - recover_steps
+
+        if step < ramp_steps:
+            return self._smoothstep((step + 1) / ramp_steps)
+        if step < recover_start:
+            return 1.0
+
+        remaining = max(0, (total - 1) - step)
+        return self._smoothstep((remaining + 1) / recover_steps)
+
+    def _set_runtime_approach_target(self) -> None:
+        if self._runtime_goal_joints is None:
+            self._prepare_runtime_approach_target()
+            if self._state != CollisionState.APPLYING:
+                return
+
+        alpha = self._runtime_alpha()
+        start = np.array(self._runtime_start_joints)
+        goal = np.array(self._runtime_goal_joints)
+        target = start + (goal - start) * alpha
+        self._robot.arm.set_joint_target_positions(target.tolist())
+
+    def should_pause_path(self, path=None, path_done=False, **kwargs) -> bool:
+        if not self._enabled:
+            return False
+
+        if self._state == CollisionState.ARMED:
+            if path_done:
+                print(
+                    "[COLLISION DEBUG] >>> WAYPOINT PATH FINISHED; "
+                    "injecting collision push before waypoint end"
+                )
+            elif path is not None:
+                return False
+            else:
+                self._armed_steps += 1
+                if self._armed_steps <= self._runtime_step_delay:
+                    return False
+            self._state = CollisionState.APPLYING
+            self._runtime_steps = 0
+
+        if self._state == CollisionState.APPLYING:
+            self._set_runtime_approach_target()
+            if self._state != CollisionState.APPLYING:
+                return False
+            self._runtime_steps += 1
+            if self._runtime_steps >= self._runtime_duration_steps:
+                self._state = CollisionState.APPLIED
+                return False
+            return True
+
+        return False
+
+    def on_waypoint(self, point: Waypoint) -> None:
+        if not self._enabled:
+            return
+        if self._state == CollisionState.IDLE:
+            if point._waypoint.get_name() == self._waypoint_fail_name:
+                if self._mode == "approach":
+                    self._arm_runtime_approach_collision(point)
+                    return
+                elif self._mode == "object":
