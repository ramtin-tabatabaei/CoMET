+    name: bad_seq_all
+    enabled: False
+    waypoints: [0, 1, 2, 3]
+    seed: 10
+
+  - type: collision
+    name: collision_1
+    enabled: False
+    # Candidate waypoint ids where the collision can be injected. One of these
+    # is randomly chosen when the failure object is created.
+    waypoints: [0, 1, 3]
+    # Collision strategy:
+    # - down: immediately moves the selected waypoint down in world z.
+    # - approach: pauses near the selected waypoint and pushes along approach_axis.
+    # - object: immediately moves the selected waypoint toward/through a target object.
+    mode: approach
+    # down only: random downward offset in meters applied to waypoint z.
+    push_down_range: [0.10, 0.20]
+    # down only: random x/y sideways offsets in meters, sampled independently.
+    lateral_range: [-0.03, 0.03]
+
+    # approach mode: runtime push distance in meters.
+    # object mode fallback: used if no target object can be found.
+    approach_distance_range: [0.08, 0.12]
+    # approach mode: waypoint-local axis used as the push direction.
+    # Use x/y/z, or prefix with "-" for the opposite direction, e.g. -z.
+    approach_axis: z
+    # approach mode: optional extra random motion in waypoint-local x/y, in meters.
+    # These are added to the main approach_axis push before solving IK.
+    # Set both ranges to [0.0, 0.0] to disable the local x/y motion.
+    approach_lateral_x_range: [-0.04, 0.04]
+    approach_lateral_y_range: [-0.04, 0.04]
+    # approach mode: caps the planar x/y component of the main approach_axis push.
+    # Local x/y offsets above are added separately after this cap.
+    max_planar_distance: 0.1
+
+    # object mode: optional explicit object names to collide with. If empty,
+    # the nearest collidable non-robot object in the task tree is used.
+    target_objects: []
+    # object mode: distance in meters to continue past the target object center.
+    object_overshoot_range: [0.05, 0.08]
+
+    # approach mode: number of simulator steps to wait after arming before push.
+    runtime_step_delay: 2
+    # approach mode: number of simulator steps over which the push is applied.
+    runtime_duration_steps: 24
+
 sub-tasks:
   - task_no: 0
     enabled: False
